# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored. Never commit real secrets.

# --- ENTSO-E Transparency Platform (used now) ---
ENTSOE_API_TOKEN=
# Greece bidding zone EIC code (verify against the ENTSO-E API guide)
ENTSOE_DOMAIN=10YGR-HTSO-----Y

# --- MongoDB, Bronze layer (connect from this machine to local Docker) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=gridpulse

# --- MySQL, Gold layer (used from the Docker Compose step) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=gridpulse
MYSQL_USER=gridpulse
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
